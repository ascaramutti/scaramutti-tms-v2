# ==========================================
# Plantilla del env file de STAGING.
# Copiar al server como /opt/tms-staging/staging.env (chmod 600) y
# completar los valores reales. NUNCA commitear el archivo completado:
# el repo es público.
# ==========================================

# --- Base de datos (contenedor db-staging) ---
# DB_USERNAME debe coincidir con el rol OWNER de los objetos del dump de
# prod (si no, los OWNER TO del restore fallan). La password es propia de
# staging (NO la de prod).
DB_USERNAME=<usuario-owner-del-dump>
DB_PASSWORD=<password-propia-de-staging>
STAGING_DB_NAME=scaramutti_tms_staging

# --- Red (solo Tailscale; el repo es público, la IP real va acá) ---
# IP de Tailscale del server. El frontend queda en http://<ip>:8088
STAGING_BIND_IP=<ip-tailscale-del-server>
STAGING_HTTP_PORT=8088
CORS_ORIGINS=http://<ip-tailscale-del-server>:8088

# --- JWT (claves PROPIAS de staging, generadas en el server; ver README) ---
STAGING_KEYS_DIR=/opt/tms-staging/keys
ACCESS_TOKEN_LIFESPAN_SECONDS=900
REFRESH_TOKEN_LIFESPAN_SECONDS=28800
