# Convenciones de formato que el editor aplica solo: codificación, saltos de línea y
# espacios. Lo demás lo decide el formateador de cada stack.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml,toml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
